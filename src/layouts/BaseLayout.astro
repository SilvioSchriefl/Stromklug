---
/**
 * Grundgerüst jeder Seite: SEO-Angaben im <head>, Kopfzeile, Fußzeile.
 * Jede Seite übergibt einen eigenen title und eine eigene description.
 */
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { SITE } from '@/config/site';
// Hauptschrift früh laden, damit der Text beim Laden nicht springt
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { ogBildFuer } from '@/lib/og/seiten';
import { OG_BREITE, OG_HOEHE } from '@/lib/og/bild';

interface Props {
  title: string;
  description: string;
  /** Strukturierte Daten (JSON-LD) für Google, optional */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** true = Seite nicht in Google aufnehmen (z. B. Impressum) */
  noindex?: boolean;
  /** "article" für Ratgeber-Artikel, sonst "website" */
  ogTyp?: 'website' | 'article';
}

const { title, description, jsonLd, noindex = false, ogTyp = 'website' } = Astro.props;
// Vorschaubild: wird beim Build unter /og/… erzeugt (siehe src/lib/og/)
const ogBild = new URL(await ogBildFuer(Astro.url.pathname), Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = Astro.url.pathname === '/' ? `${SITE.name} – ${SITE.claim}` : `${title} | ${SITE.name}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#047857" />

    <!-- Open Graph (Vorschau beim Teilen in WhatsApp, Facebook usw.) -->
    <meta property="og:type" content={ogTyp} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_BREITE)} />
    <meta property="og:image:height" content={String(OG_HOEHE)} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {
      SITE.cloudflareAnalyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cloudflareAnalyticsToken })}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:shadow"
    >
      Zum Inhalt springen
    </a>
    <SiteHeader />
    <main id="inhalt" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
