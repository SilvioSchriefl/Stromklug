---
/**
 * Seitenvorlage für alle Rechner.
 * Reihenfolge: Brotkrümel → H1 + Einleitung → Rechner + Erklärung (Slot) → FAQ → passende Rechner
 */
import BaseLayout from './BaseLayout.astro';
import Faq, { type FaqItem } from '@/components/Faq.astro';
import { CALCULATORS, SITE } from '@/config/site';
import { artikelZuRechner } from '@/lib/ratgeber';

interface Props {
  /** Für den <title>, z. B. "Balkonkraftwerk-Rechner: Ertrag & Amortisation" */
  title: string;
  description: string;
  h1: string;
  intro: string;
  slug: string;
  faq: FaqItem[];
  /** Slugs passender anderer Rechner */
  related: string[];
}

const { title, description, h1, intro, slug, faq, related } = Astro.props;
const pageUrl = new URL(`/${slug}/`, Astro.site).toString();
const current = CALCULATORS.find((c) => c.slug === slug);
const relatedCalcs = related
  .map((s) => CALCULATORS.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
const artikel = await artikelZuRechner(slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: h1,
      description,
      inLanguage: 'de-DE',
      isPartOf: { '@type': 'WebSite', name: SITE.name, url: Astro.site?.toString() },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: Astro.site?.toString() },
        { '@type': 'ListItem', position: 2, name: current?.title ?? h1, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.frage,
        acceptedAnswer: { '@type': 'Answer', text: f.antwort },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="container-page pt-4 pb-8">
    <nav aria-label="Brotkrümelnavigation" class="text-sm text-ink-soft">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="underline underline-offset-2 hover:text-ink">Start</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{current?.title ?? h1}</li>
      </ol>
    </nav>

    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">{h1}</h1>
    <p class="mt-3 max-w-prose text-lg text-ink-soft">{intro}</p>

    <div class="mt-6">
      <slot />
    </div>

    <Faq items={faq} />

    {
      artikel.length > 0 && (
        <section aria-labelledby="ratgeber-titel" class="mt-12">
          <h2 id="ratgeber-titel" class="text-2xl font-bold text-ink">
            Ratgeber zum Thema
          </h2>
          <ul class="mt-4 space-y-2">
            {artikel.map((a) => (
              <li>
                <a href={`/ratgeber/${a.id}/`} class="font-medium text-sea-700 underline underline-offset-2 hover:text-sea-900">
                  {a.data.titel}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      relatedCalcs.length > 0 && (
        <section aria-labelledby="passend-titel" class="mt-12">
          <h2 id="passend-titel" class="text-2xl font-bold text-ink">
            Passende Rechner
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {relatedCalcs.map((c) => (
              <li>
                {c.status === 'live' ? (
                  <a
                    href={`/${c.slug}/`}
                    class="block h-full rounded-xl border border-line p-4 hover:border-brand-600 hover:bg-brand-50"
                  >
                    <span class="font-semibold text-ink">{c.title}</span>
                    <span class="mt-1 block text-sm text-ink-soft">{c.teaser}</span>
                  </a>
                ) : (
                  <div class="h-full rounded-xl border border-dashed border-line bg-surface p-4">
                    <span class="font-semibold text-ink">{c.title}</span>
                    <span class="mt-1 block text-sm text-ink-soft">In Vorbereitung</span>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
