---
interface Props {
  name: string;
  label: string;
  value: string;
  options: { value: string; label: string }[];
  hint?: string;
  formId: string;
}

const { name, label, value, options, hint, formId } = Astro.props;
const id = `${formId}-${name}`;
---

<div class="field">
  <label for={id} class="block font-semibold text-ink">{label}</label>
  {hint && <p id={`${id}-hint`} class="mt-1 text-sm text-ink-soft">{hint}</p>}
  <select
    id={id}
    name={name}
    aria-describedby={hint ? `${id}-hint` : undefined}
    class="mt-2 w-full rounded-lg border border-line bg-white px-3 py-3 text-lg text-ink focus:border-sea-600 focus:ring-2 focus:ring-sea-600/30 focus:outline-none"
  >
    {
      options.map((o) => (
        <option value={o.value} selected={o.value === value}>
          {o.label}
        </option>
      ))
    }
  </select>
</div>
