---
import { SITE, FOOTER_LINKS } from '@/config/site';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-line bg-surface">
  <div class="container-page py-8 text-sm text-ink-soft">
    <p class="max-w-prose">
      Alle Ergebnisse sind Schätzungen auf Basis der angegebenen Annahmen und ersetzen keine individuelle Beratung.
    </p>
    <nav aria-label="Rechtliches und Informationen" class="mt-6">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          FOOTER_LINKS.map((link) => (
            <li>
              <a href={link.href} class="underline underline-offset-2 hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="mt-6">© {year} {SITE.name}</p>
  </div>
</footer>
