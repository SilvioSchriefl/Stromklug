---
export interface FaqItem {
  frage: string;
  antwort: string;
}
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---

<section aria-labelledby="faq-titel" class="mt-12">
  <h2 id="faq-titel" class="text-2xl font-bold text-ink">Häufige Fragen</h2>
  <div class="mt-4 divide-y divide-line rounded-xl border border-line bg-white">
    {
      items.map((item) => (
        <details class="group p-4">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-ink">
            <h3>{item.frage}</h3>
            <span aria-hidden="true" class="text-xl leading-6 text-brand-700 transition-transform group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 leading-relaxed text-ink-soft">{item.antwort}</p>
        </details>
      ))
    }
  </div>
</section>
