---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, CALCULATORS } from '@/config/site';
import { alleArtikel } from '@/lib/ratgeber';

const neueArtikel = (await alleArtikel()).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: Astro.site?.toString(),
  inLanguage: 'de-DE',
  description: SITE.description,
};

const trustPoints = [
  {
    title: 'Offene Formeln',
    text: 'Unter jedem Rechner steht genau, wie wir rechnen und welche Annahmen wir treffen.',
  },
  {
    title: 'Quellen mit Datum',
    text: 'Standardwerte wie der Strompreis stammen aus seriösen Quellen. Du kannst jeden Wert ändern.',
  },
  {
    title: 'Keine Cookies',
    text: 'Kein Tracking, keine Cookie-Banner. Deine Eingaben bleiben in deinem Browser.',
  },
  {
    title: 'Klar gekennzeichnet',
    text: 'Empfehlungs-Links sind als Werbung markiert und beeinflussen nie das Rechenergebnis.',
  },
];
---

<BaseLayout title="Startseite" description={SITE.description} jsonLd={jsonLd}>
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="container-page py-12 sm:py-16">
      <h1 class="max-w-3xl text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">
        Rechne in einer Minute aus, wo du beim Strom sparst.
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        Kostenlose Rechner für Balkonkraftwerk, Gerätekosten und Stromtarife – mit nachvollziehbaren Formeln und
        aktuellen Werten für Deutschland.
      </p>
      <a href="#rechner" class="btn-primary mt-8">Zu den Rechnern</a>
    </div>
  </section>

  <section id="rechner" aria-labelledby="rechner-titel" class="container-page scroll-mt-4 py-12">
    <h2 id="rechner-titel" class="text-2xl font-bold sm:text-3xl">Alle Rechner</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        CALCULATORS.map((calc) => (
          <li>
            {calc.status === 'live' ? (
              <a
                href={`/${calc.slug}/`}
                class="group flex h-full flex-col rounded-xl border border-line bg-white p-5 shadow-sm transition hover:border-brand-600 hover:shadow-md"
              >
                <h3 class="text-lg font-semibold text-ink group-hover:text-brand-800">{calc.title}</h3>
                <p class="mt-2 flex-1 text-ink-soft">{calc.teaser}</p>
                <span class="mt-4 font-semibold text-brand-700">
                  Jetzt berechnen <span aria-hidden="true">→</span>
                </span>
              </a>
            ) : (
              <div class="flex h-full flex-col rounded-xl border border-dashed border-line bg-surface p-5">
                <h3 class="text-lg font-semibold text-ink">{calc.title}</h3>
                <p class="mt-2 flex-1 text-ink-soft">{calc.teaser}</p>
                <span class="mt-4 text-sm font-medium text-ink-soft">In Vorbereitung</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  {
    neueArtikel.length > 0 && (
      <section aria-labelledby="ratgeber-titel" class="container-page pb-12">
        <h2 id="ratgeber-titel" class="text-2xl font-bold sm:text-3xl">
          Neu im Ratgeber
        </h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {neueArtikel.map((a) => (
            <li>
              <a
                href={`/ratgeber/${a.id}/`}
                class="group block h-full rounded-xl border border-line bg-white p-5 shadow-sm transition hover:border-brand-600 hover:shadow-md"
              >
                <h3 class="font-semibold text-ink group-hover:text-brand-800">{a.data.titel}</h3>
                <p class="mt-2 text-sm text-ink-soft">{a.data.beschreibung}</p>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-6">
          <a href="/ratgeber/" class="font-semibold text-brand-700 underline underline-offset-2 hover:text-brand-900">
            Alle Ratgeber-Artikel
          </a>
        </p>
      </section>
    )
  }

  <section aria-labelledby="vertrauen-titel" class="border-y border-line bg-surface">
    <div class="container-page py-12">
      <h2 id="vertrauen-titel" class="text-2xl font-bold sm:text-3xl">Warum du unseren Zahlen trauen kannst</h2>
      <ul class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          trustPoints.map((point) => (
            <li class="flex gap-3">
              <svg aria-hidden="true" class="mt-1 h-5 w-5 flex-none text-brand-700" viewBox="0 0 20 20" fill="currentColor">
                <path
                  fill-rule="evenodd"
                  d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z"
                  clip-rule="evenodd"
                />
              </svg>
              <div>
                <h3 class="font-semibold text-ink">{point.title}</h3>
                <p class="mt-1 text-ink-soft">{point.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
